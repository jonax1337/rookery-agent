# Rookery Agent - configuration
# NOTE: No model API keys are required. Auth comes from your logged-in
# Claude Code (`claude /login`) and Codex (`codex login`) CLIs.

ROOKERY_PORT=4317
ROOKERY_HOST=127.0.0.1
ROOKERY_HOME=
# Overrides the assistant's own working directory (default: <home>/workspace).
ROOKERY_WORKSPACE=
ROOKERY_DEFAULT_PROVIDER=claude
ROOKERY_DEFAULT_MODEL=
# low | medium | high | xhigh | max. Unset leaves each provider's own default.
ROOKERY_DEFAULT_EFFORT=
# chat | read | write | full. See README.md#permission-levels.
ROOKERY_PERMISSION=
ROOKERY_LOG_LEVEL=info
# Shared secret for the API. Empty = no authentication; keep the loopback host.
ROOKERY_TOKEN=

# Assistant persona.
ROOKERY_ASSISTANT_NAME=
ROOKERY_USER_NAME=

# Voice defaults; see README.md#voice for the full engine list.
ROOKERY_VOICE_LANG=en-GB
ROOKERY_VOICE_ENGINE=edge
ROOKERY_VOICE_EDGE_VOICE=en-GB-RyanNeural

# Optional premium voices for the hands-free screen. Without these the free
# Microsoft Edge neural voices are used; nothing else is required.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Force the line-based CLI instead of the full-screen TUI (also `--plain`).
ROOKERY_TUI=
# packages/web dev server only: where Vite proxies /api and /ws to.
ROOKERY_BACKEND=http://127.0.0.1:4317

# The server reads ~/.rookery/.env and this file (copied to .env) on start;
# values already in the shell win.
